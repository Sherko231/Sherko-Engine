<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="EmptyCatchBlock">
            <property name="commentFormat" value="(?!)"/>
            <property name="exceptionVariableName" value="(?!)"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="^\s*java\.lang\.Math\.(?:abs|ceil|floor|max|min|sqrt|sin|cos|tan|pow|log|log10)\s*\([^;]*\)\s*;\s*$"/>
            <property name="ignoreComments" value="true"/>
            <property name="maximum" value="0"/>
            <property name="message" value="Ignored return value from a side-effect-free java.lang.Math call."/>
        </module>
    </module>
</module>
